{
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "outDir": "lib",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/client",
    "src/client/**/*",
    "src/webui/client",
    "src/webui/client/**/*",
    "src/worktree/client",
    "src/worktree/client/**/*",
    "src/lan-auth/client",
    "src/lan-auth/client/**/*",
    "src/input-history/client",
    "src/input-history/client/**/*"
  ]
}
