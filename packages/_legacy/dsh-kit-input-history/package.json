{
  "name": "dsh-kit-input-history",
  "version": "0.2.1",
  "description": "DSH 输入历史（dsh-kit 全家桶功能包，由 dsh-kit 聚合包挂载）——记录当前会话发送的消息，输入框无命令菜单时按 ↑/↓ 切换回填",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "lib/*.js.map",
    "lib/types/**/*.d.ts"
  ],
  "scripts": {
    "build": "tsc -b && tsdown",
    "build:host": "tsc -b",
    "build:client": "tsdown",
    "typecheck": "tsc -b --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/node": "^26.2.0",
    "typescript": "^5.6.0"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
